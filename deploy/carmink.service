# /etc/systemd/system/carmink.service
[Unit]
Description=Carmink Telegram bot and Mini App backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=carmink
WorkingDirectory=/opt/carmink
EnvironmentFile=/opt/carmink/.env
ExecStart=/opt/carmink/venv/bin/python carmink.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
