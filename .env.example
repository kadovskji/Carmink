# Copy to .env (never commit it). systemd reads it with EnvironmentFile; in PyCharm set the same
# variables in the run configuration.
BOT_TOKEN=123456:replace-me
BOT_USERNAME=carminkgame
# Short name chosen in BotFather with /newapp: the Mini App link is t.me/<BOT_USERNAME>/<MINIAPP_SHORTNAME>
MINIAPP_SHORTNAME=app
# Your Telegram user id (comma separated for more): can use /admin in private chat
ADMIN_ID=
WEB_PORT=8081
DB_FILE=carmink.db
LOG_FILE=carmink.log
# Commands handled in groups only when written as /command@carminkgame (optional, comma separated)
REQUIRE_TAG=
# Webhook mode (a little faster than polling): a long random string, e.g. `openssl rand -hex 24`.
# Leave empty to use long polling. PUBLIC_URL is the HTTPS address nginx serves.
WEBHOOK_SECRET=
PUBLIC_URL=https://carmink.suketchi.art
